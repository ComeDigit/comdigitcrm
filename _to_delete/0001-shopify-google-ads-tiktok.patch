+function normalizeShopDomain(input: string): string | null {
+  let v = input.trim().toLowerCase();
+  v = v.replace(/^https?:\/\//, "").replace(/\/.*$/, "");
+  if (!v) return null;
+  if (!v.includes(".")) v = `${v}.myshopify.com`;
+  if (!/^[a-z0-9][a-z0-9-]*\.myshopify\.com$/.test(v)) {
+    return null;
+  }
+  return v;
