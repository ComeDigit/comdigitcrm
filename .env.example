# ── ComeDigit CRM environment ──────────────────────────────────────
# With NOTHING set, the app runs in DEMO MODE: deterministic sample
# data, no auth, zero keys. Fill these in to go live.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — NEVER prefixed NEXT_PUBLIC, never sent to the browser.
SUPABASE_SECRET_KEY=

# Postgres pooled connection string (Dashboard → Database → Connection string)
DATABASE_URL=

# 32+ char random string — encrypts integration credentials at rest
# (openssl rand -hex 32)
APP_ENCRYPTION_KEY=

# Protects /api/cron/* (set the same value in Vercel Cron headers)
CRON_SECRET=

# ── Integrations (added per phase; all server-side only) ───────────
SHOPIFY_WEBHOOK_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
